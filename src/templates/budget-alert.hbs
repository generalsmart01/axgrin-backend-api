<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Budget Alert</title>
</head>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
    <h2 style="color: #ff9800; margin-top: 0;">Budget Alert</h2>
    <p>Hi {{firstName}},</p>
    <p>You're approaching your budget limit for <strong>{{categoryName}}</strong>.</p>
    <div style="background-color: white; padding: 15px; border-radius: 5px; margin: 20px 0;">
      <p style="margin: 5px 0;"><strong>Budget:</strong> {{budgetAmount}}</p>
      <p style="margin: 5px 0;"><strong>Spent:</strong> {{spentAmount}}</p>
      <p style="margin: 5px 0;"><strong>Remaining:</strong> {{remainingAmount}}</p>
      <p style="margin: 5px 0;"><strong>Usage:</strong> {{percentageUsed}}%</p>
    </div>
    {{#if isOverBudget}}
    <p style="color: #dc3545; font-weight: bold;">⚠️ You've exceeded your budget for this category!</p>
    {{else}}
    <p>You have {{percentageRemaining}}% of your budget remaining for this period.</p>
    {{/if}}
    <div style="margin: 30px 0; text-align: center;">
      <a href="{{dashboardUrl}}" style="background-color: #4CAF50; color: white; padding: 12px 30px; text-decoration: none; border-radius: 5px; display: inline-block;">View Budget Dashboard</a>
    </div>
    <p>Best regards,<br>The Axgrin Team</p>
  </div>
</body>
</html>

